Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebGroup.pkg

Use cequipoDataDictionary.dd
Use centrenadorDataDictionary.dd

Register_Object oSelectEquipo

Object oZoomEntrenador is a cWebView
    Set psCaption to "Entrenador"
    Set pbShowCaption to False
    Set piMaxWidth to 1024
    Set peViewType to vtZoom
    Set Verify_Save_msg to 0
    Set psStateViewName to "Entrenador"

    Object oEquipoDataDictionary is a cequipoDataDictionary
    End_Object

    Object oEntrenadorDataDictionary is a centrenadorDataDictionary
        Set DDO_Server to oEquipoDataDictionary
    End_Object

    Set Main_DD to oEntrenadorDataDictionary
    Set Server to oEntrenadorDataDictionary

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        WebSetResponsive piColumnCount rmMobilePortrait to 6
        WebSetResponsive piColumnCount rmMobileLandscape to 9

        Object oWebGroup1 is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 6
            Set pbShowBorder to False
            Set pbShowCaption to False

            Object oEntrenador_ID is a cWebForm
                Entry_Item entrenador.ID
                Set piColumnSpan to 12
                Set psLabel to "ID"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oEntrenador_Nombre is a cWebForm
                Entry_Item entrenador.Nombre
                Set piColumnSpan to 12
                Set psLabel to "Nombre"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oEntrenador_Apellido is a cWebForm
                Entry_Item entrenador.Apellido
                Set piColumnSpan to 12
                Set psLabel to "Apellido"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oEntrenador_Nacionalidad is a cWebForm
                Entry_Item entrenador.Nacionalidad
                Set piColumnSpan to 12
                Set psLabel to "Nacionalidad"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oEntrenador_EquipoID is a cWebForm
                Entry_Item entrenador.EquipoID
                Set piColumnSpan to 12
                Set psLabel to "ID de equipo"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oEquipo_Nombre is a cWebForm
                Entry_Item equipo.Nombre
                Set piColumnSpan to 12
                Set psLabel to "Equipo"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectEquipo

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCaption to "Guardar"
            Set psCSSClass to "WebSaveMenuItem"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oEditBtn is a cWebMenuItem
            Set psCaption to "Editar"
            Set psCSSClass to "WebEditMenuItem"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebMenuItem
            Set psCaption to "Eliminar"
            Set psCSSClass to "WebDeleteMenuItem"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCaption to "Deshacer cambios"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object

    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoDDO Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        Boolean bHasRecord
        Get HasRecord of oEntrenadorDataDictionary to bHasRecord
        If bHasRecord Begin
            Send SetBreadcrumbCaption (Trim(entrenador.Nombre))
        End
        Else Begin
            Send SetBreadcrumbCaption "Nuevo Entrenador"
        End

        Send SetActionButtons
    End_Procedure

End_Object
