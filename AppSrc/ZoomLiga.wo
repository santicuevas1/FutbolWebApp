Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebGroup.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd

Register_Object oSelectEquipo
Register_Object oZoomEquipo

Object oZoomLiga is a cWebView
    Set psCaption to "Liga"
    Set pbShowCaption to False
    Set piMaxWidth to 1024
    Set peViewType to vtZoom
    Set Verify_Save_msg to 0
    Set psStateViewName to "Liga"

    Object oLigaDataDictionary is a cligaDataDictionary
    End_Object

    // DDO hijo constreñido a la liga actual (para la lista embebida)
    Object oEquipoDataDictionary is a cequipoDataDictionary
        Set DDO_Server to oLigaDataDictionary
        Set Constrain_file to liga.File_Number
    End_Object

    Set Main_DD to oLigaDataDictionary
    Set Server to oLigaDataDictionary

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        WebSetResponsive piColumnCount rmMobilePortrait to 6
        WebSetResponsive piColumnCount rmMobileLandscape to 9

        Object oWebGroup1 is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 6
            Set pbShowBorder to False
            Set pbShowCaption to False

            Object oLiga_ID is a cWebForm
                Entry_Item liga.ID
                Set piColumnSpan to 12
                Set psLabel to "ID"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oLiga_Nombre is a cWebForm
                Entry_Item liga.Nombre
                Set piColumnSpan to 12
                Set psLabel to "Nombre"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oLiga_Pais is a cWebForm
                Entry_Item liga.Pais
                Set piColumnSpan to 12
                Set psLabel to "Pais"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oLiga_Equipos is a cWebForm
                Entry_Item liga.Equipos
                Set piColumnSpan to 12
                Set psLabel to "Equipos"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

            Object oLiga_EquiposMax is a cWebForm
                Entry_Item liga.EquiposMax
                Set piColumnSpan to 12
                Set psLabel to "Equipos maximos"
                Set peLabelAlign to alignLeft
                Set peLabelPosition to lpTop
            End_Object

        End_Object

        // 2o: en vez del boton, los equipos de la liga dentro del propio Zoom
        Object oEquiposLista is a cWebList
            Set Server to oEquipoDataDictionary
            Set piColumnSpan to 12
            Set pbFillHeight to False
            Set piHeight to 200
            Set pbShowHeader to True
            Set pbServerOnRowClick to True

            WebRegisterPath ntNavigateForward oZoomEquipo

            Procedure OnRowClick String sRowID
                Send NavigatePath
            End_Procedure

            Object oEquiposLista_ID is a cWebColumn
                Entry_Item equipo.ID
                Set psCaption to "ID"
                Set piWidth to 40
            End_Object

            Object oEquiposLista_Nombre is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Nombre"
                Set piWidth to 100
            End_Object
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCaption to "Guardar"
            Set psCSSClass to "WebSaveMenuItem"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oEditBtn is a cWebMenuItem
            Set psCaption to "Editar"
            Set psCSSClass to "WebEditMenuItem"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebMenuItem
            Set psCaption to "Eliminar"
            Set psCSSClass to "WebDeleteMenuItem"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCaption to "Deshacer cambios"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object

        // 1o: boton que muestra los equipos de esta liga (nfFromParent -> SelectEquipo constreñido)
        Object oEquiposBtn is a cWebMenuItem
            Set psCaption to "Ver equipos"

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnClick
                Send NavigatePath
            End_Procedure
        End_Object

    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False
        WebSet pbRender of oEquiposBtn to bHasRecord

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoDDO Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        Boolean bHasRecord
        Get HasRecord of oLigaDataDictionary to bHasRecord
        If bHasRecord Begin
            Send SetBreadcrumbCaption (Trim(liga.Nombre))
        End
        Else Begin
            Send SetBreadcrumbCaption "Nuevo Liga"
        End

        Send SetActionButtons
    End_Procedure

End_Object
