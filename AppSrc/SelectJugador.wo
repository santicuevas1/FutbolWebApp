Use cWebView.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cWebColumn.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg

Use cjugadorDataDictionary.dd

Register_Object oZoomJugador

Object oSelectJugador is a cWebView
    Set psCaption to "Jugadores"
    Set pbShowCaption to False
    Set piMaxWidth to 1024
    Set piColumnCount to 6
    Set peViewType to vtSelect
    Set psStateViewName to "Jugadores"

    WebSetResponsive piColumnCount rmTabletPortrait to 3

    Object oJugadorDataDictionary is a cjugadorDataDictionary
        Set Auto_Fill_State to True
    End_Object

    Set Main_DD to oJugadorDataDictionary
    Set Server to oJugadorDataDictionary

    Object oList is a cWebList
        Set piColumnSpan to 0
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set piSortColumn to 1
        Set pbShowHeader to True
        Set pbAllowDeleteRow to True

        WebRegisterPath ntNavigateForward oZoomJugador

        Procedure OnRowClick String sRowID
            Send NavigatePath
        End_Procedure

        Object oJugador_ID is a cWebColumn
            Entry_Item jugador.ID
            Set psCaption to "ID"
            Set piWidth to 40
        End_Object

        Object oJugador_Nombre is a cWebColumn
            Entry_Item jugador.Nombre
            Set psCaption to "Nombre"
            Set piWidth to 100
        End_Object

        Object oJugador_Apellido is a cWebColumn
            Entry_Item jugador.Apellido
            Set psCaption to "Apellido"
            Set piWidth to 100
        End_Object

        Object oJugador_Nacionalidad is a cWebColumn
            Entry_Item jugador.Nacionalidad
            Set psCaption to "Nacionalidad"
            Set piWidth to 100
        End_Object

        Object oJugador_EquipoID is a cWebColumn
            Entry_Item jugador.EquipoID
            Set psCaption to "ID de equipo"
            Set piWidth to 100
        End_Object

    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCaption to "Buscar"
            Set psCSSClass to "WebPromptMenuItem"

            Procedure OnClick
                Send Search of oList
            End_Procedure
        End_Object

        Object oNewButton is a cWebMenuItem
            Set psCaption to "Nuevo"
            Set psCSSClass to "WebClearMenuItem"

            WebRegisterPath ntNavigateForward oZoomJugador Self "NewJugador"

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure
        End_Object

    End_Object

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        Send SetBreadcrumbCaption "Jugadores"
        Send SetHeaderCaption "Jugadores"
    End_Procedure

End_Object
